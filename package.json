{
  "name": "aidevteam",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "lint": "eslint .",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && pnpm -r test",
    "test:integration": "pnpm build:packages && pnpm -r --workspace-concurrency=1 --if-present test:integration",
    "test:scripts": "node --test scripts/progress.test.mjs",
    "progress": "node scripts/progress.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "lodash": "4.17.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  }
}
