# Copy to $DEPLOY_DIR/host.env on the VPS (default /opt/aidevteam/host.env). No secrets here.
# Host-specific network settings; release images go to release.env (written by deploy.sh).

# LAN address/port the NPM server proxies to (production VPS)
WEB_PUBLISH_ADDR=192.168.250.30
WEB_PUBLISH_PORT=3301
# Only the NPM server (192.168.250.10) should reach this port: enforce with a DOCKER-USER rule (docs/operations/CICD.md §3.4)

# API stays on loopback; used only for health checks on the VPS
API_PORT=3001

# App config + secrets file (created by the operator, mode 600, never committed)
APP_ENV_FILE=/etc/aidevteam/app.env

# Internal compose network (api <-> web). Must not overlap the LAN (192.168.250.0/24).
# app.env must set TRUSTED_PROXY_IPS to the same subnet.
INTERNAL_SUBNET=172.30.250.0/24
