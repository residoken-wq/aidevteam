# ==============================================================================
# DEV ONLY - FAKE ENVIRONMENT CONFIGURATION (COMMITTED)
# DO NOT PUT REAL SECRETS HERE.
# Real secrets belong in secret manager / /etc/aidevteam/app.env on VPS.
#
# Real GitHub OAuth login does not work with these fake values.
# For local UI testing/development, use seeded fake users and fake sessions
# as demonstrated in tests/e2e/run-local.sh.
# ==============================================================================

# api
PORT=3001
MOCK_WORKER_ENABLED=true

# web
API_INTERNAL_URL=http://localhost:3001

# database (local dev postgres on 127.0.0.1:55433)
DATABASE_URL=postgres://postgres@127.0.0.1:55433/aidevteam_dev
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:55433/aidevteam_test

# GitHub OAuth (P1-05G) — FAKE values only
PUBLIC_BASE_URL=http://localhost:3000
GITHUB_OAUTH_CLIENT_ID=Iv1.fake-dev-client-id
GITHUB_OAUTH_CLIENT_SECRET=dev-fake-not-a-secret
SESSION_TTL_MINUTES=480

# GitHub repository for PR comment links in Release Approvals (fake for dev)
APPROVAL_REPO=example-org/aidevteam

# Trusted proxy IPs
TRUSTED_PROXY_IPS=127.0.0.1
