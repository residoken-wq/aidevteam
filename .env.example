# FAKE example values only. Real values live in the secret manager / /etc/aidevteam/app.env on the VPS.
# api
PORT=3001
MOCK_WORKER_ENABLED=false
# web
API_INTERNAL_URL=http://localhost:3001
# database (FAKE local example — never put real credentials here)
DATABASE_URL=postgres://app:change-me@localhost:5432/aidevteam_dev
# integration tests: database name MUST end with _test (tests drop the schema)
TEST_DATABASE_URL=postgres://postgres@localhost:5432/aidevteam_test
# GitHub OAuth (P1-05G) — FAKE values. Real secret only in /etc/aidevteam/app.env on the VPS.
PUBLIC_BASE_URL=https://cc.example.com
GITHUB_OAUTH_CLIENT_ID=Iv1.exampleclientid
GITHUB_OAUTH_CLIENT_SECRET=replace-me-in-secret-manager-only
SESSION_TTL_MINUTES=480
# Subnet of the internal compose network (the web container is the only proxy hop the api sees)
TRUSTED_PROXY_IPS=172.30.250.0/24
