{
  "name": "@aidevteam/db",
  "version": "0.0.0",
  "private": true,
  "description": "PostgreSQL schema (Drizzle), up/down SQL migrations and fake seed data",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration --no-file-parallelism",
    "migrate": "node dist/cli.js",
    "seed": "node dist/seed-cli.js",
    "allowlist": "node dist/allowlist-cli.js",
    "admin": "node dist/admin-cli.js"
  },
  "dependencies": {
    "@aidevteam/contracts": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.3",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
